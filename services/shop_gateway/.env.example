# Scene 06 Shop Gateway — environment template
# Copy to .env and fill in real values. Never commit .env to git.
#
#   copy services\shop_gateway\.env.example services\shop_gateway\.env
#
# PowerShell (from services/shop_gateway):
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$') {
#       Set-Item -Path "env:$($matches[1])" -Value $matches[2].Trim('"')
#     }
#   }
#
# Spec: references/scene06-shop-gateway-spec.md

# =============================================================================
# A. Gateway process (terminal A — run_shop_gateway.py)
# =============================================================================

# Listen (run_shop_gateway.py also accepts --host / --port)
# SHOP_GATEWAY_HOST=127.0.0.1
# SHOP_GATEWAY_PORT=8791

# Backend selection: auto | partner | research | structured
SHOP_GATEWAY_BACKEND=partner

# Optional Bearer auth on POST /v1/shop/products/search (Skill sends TIKTOK_SHOP_HTTP_API_KEY)
# SHOP_GATEWAY_API_KEY=your-gateway-shared-secret

SHOP_GATEWAY_ID=shop-gateway-dev-01
# SHOP_GATEWAY_SCOPES=product.read

# --- Dev: Partner mock (no TikTok credentials) ---
SHOP_GATEWAY_PARTNER_MOCK=1

# --- Partner: TikTok Shop Open API (authorized shop catalog) ---
# SHOP_GATEWAY_PARTNER_MOCK=0
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=
# TIKTOK_SHOP_CIPHER=
# TIKTOK_SHOP_ACCESS_TOKEN=
# TIKTOK_SHOP_API_VERSION=202309
# TIKTOK_SHOP_OPEN_API_BASE=https://open-api.tiktokglobalshop.com
# Optional extra body for products/search (JSON string)
# TIKTOK_SHOP_PARTNER_SEARCH_BODY_JSON={"page_size":20,"status":"ACTIVATE"}
# TIKTOK_SHOP_PARTNER_SEARCH_STATUS=ACTIVATE

# --- Partner: forward to your internal search service (shop-bridge / 数据中台) ---
# 完整预设另见：.env.internal-forward.example
# SHOP_GATEWAY_PARTNER_MOCK=0
# SHOP_GATEWAY_BACKEND=partner
# SHOP_GATEWAY_PARTNER_SEARCH_URL=https://shop-bridge.internal.example/api/v1/shop/products/search
# TIKTOK_SHOP_ACCESS_TOKEN=clt_REPLACE_WITH_MERCHANT_ACCESS_TOKEN
# SHOP_GATEWAY_API_KEY=gateway-shared-secret
# Skill 侧验真常用 internal-gateway（见 spec §2 internal-gateway 表）：
# TIKTOK_SHOP_SOURCE_ATTESTATION=internal-gateway
# TIKTOK_SHOP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost,shop-gateway.internal.example

# --- Research API (shop_name query; not global keyword catalog) ---
# SHOP_GATEWAY_BACKEND=research
# SHOP_GATEWAY_PARTNER_MOCK=0
# TIKTOK_RESEARCH_CLIENT_KEY=
# TIKTOK_RESEARCH_CLIENT_SECRET=
# TIKTOK_RESEARCH_ACCESS_TOKEN=
# TIKTOK_SHOP_NAME=Your Shop Display Name

# --- Structured fallback (no TikTok network) ---
# SHOP_GATEWAY_BACKEND=structured
# SHOP_GATEWAY_STRUCTURED_JSON=D:\path\to\competitor_products.json

# =============================================================================
# B. Skill client (terminal B — run_scene06.py / start_capture_pack_run)
#    Set in the same shell or a separate .env; do not commit secrets here either.
# =============================================================================

# Gateway base URL (no trailing slash)
TIKTOK_SHOP_HTTP_URL=http://127.0.0.1:8791

# Must match SHOP_GATEWAY_API_KEY when gateway auth is enabled
# TIKTOK_SHOP_HTTP_API_KEY=your-gateway-shared-secret

# Provenance: official | authorized-partner | internal-gateway | unverified
TIKTOK_SHOP_SOURCE_ATTESTATION=official
TIKTOK_SHOP_REQUIRE_VERIFIED=1

# Comma-separated allowed gateway hostnames
TIKTOK_SHOP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost

# Default search parameters (CLI can override)
TIKTOK_SHOP_KEYWORD=beauty
TIKTOK_SHOP_REGION=US
TIKTOK_SHOP_LIMIT=10

# Optional: auto HTTP sync on Scene 06 import (usually use --shop-sync / run_scene06 instead)
# TIKTOK_SHOP_SYNC_ON_IMPORT=0

# Structured-only path (no gateway) — use with run_scene06.py --data-path structured
# TIKTOK_SHOP_SOURCE_ATTESTATION=unverified
# TIKTOK_SHOP_REQUIRE_VERIFIED=0

# =============================================================================
# C. Not recommended for Scene 06 official path
# =============================================================================

# Third-party Clipcat (stays unverified unless wrapped in your gateway with honest source metadata)
# CLIPCAT_API_KEY=
