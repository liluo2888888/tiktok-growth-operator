# Preset: Scene 06 Shop Gateway → 内网 Partner 转发（非直连 TikTok Open API）
#
# 适用：你们已有 shop-bridge / 数据中台，负责 OAuth、签名、限流；本仓库 Gateway 只做
# 协议归一化 + source 元数据，Skill 只做验真与 Scene 06 入库。
#
# 用法：
#   copy .env.internal-forward.example .env
#   编辑 URL 与 token 后，按 README 加载环境变量并启动网关。
#
# 架构：
#   Skill (run_scene06) → 本机 Gateway :8791 → SHOP_GATEWAY_PARTNER_SEARCH_URL（内网）
#                         ← 必须返回 products[] + 建议附带 source（Gateway 会补全）

# =============================================================================
# Gateway（终端 A）
# =============================================================================

SHOP_GATEWAY_BACKEND=partner
SHOP_GATEWAY_PARTNER_MOCK=0

# 内网商品搜索端点（Gateway 会 POST JSON，见下方「上游契约」）
SHOP_GATEWAY_PARTNER_SEARCH_URL=https://shop-bridge.internal.example/api/v1/shop/products/search

# 商户 OAuth access token（仅存在于 Gateway 进程；不要写入 skill 仓库或 Codex 日志）
TIKTOK_SHOP_ACCESS_TOKEN=clt_REPLACE_WITH_MERCHANT_ACCESS_TOKEN

# 可选：Gateway 对外 Bearer（Skill 侧 TIKTOK_SHOP_HTTP_API_KEY 需一致）
SHOP_GATEWAY_API_KEY=gateway-shared-secret-REPLACE_ME

SHOP_GATEWAY_ID=shop-gateway-prod-cn-01
# SHOP_GATEWAY_SCOPES=product.read

# =============================================================================
# Skill 客户端（终端 B — 可与 Gateway 分机器；只配置「对外」项）
# =============================================================================

TIKTOK_SHOP_HTTP_URL=http://127.0.0.1:8791
TIKTOK_SHOP_HTTP_API_KEY=gateway-shared-secret-REPLACE_ME

# 内网转发 + 诚实元数据时，常用 internal-gateway；若上游即 TikTok Partner Open API 则用 official
TIKTOK_SHOP_SOURCE_ATTESTATION=internal-gateway
TIKTOK_SHOP_REQUIRE_VERIFIED=1

# 允许访问的 Gateway 主机名（本机 + 若 Skill 直连内网 Gateway 则加上内网域名）
TIKTOK_SHOP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost,shop-gateway.internal.example

TIKTOK_SHOP_KEYWORD=beauty
TIKTOK_SHOP_REGION=US
TIKTOK_SHOP_LIMIT=20

# =============================================================================
# 上游契约（你们的 shop-bridge 需实现）
# =============================================================================
#
# Gateway → 上游  POST SHOP_GATEWAY_PARTNER_SEARCH_URL
# Headers:
#   Content-Type: application/json
#   Authorization: Bearer <TIKTOK_SHOP_ACCESS_TOKEN>
# Body:
#   {"keyword":"beauty","region":"US","limit":20}
#
# 上游 → Gateway  200 JSON（二选一）：
#
# (1) 仅商品列表（Gateway 自动补 source，api_family=partner_forward）：
#   {"products":[{"product_id":"...","title":"...","price":"18.99", ...}]}
#
# (2) 商品 + 来源（推荐；便于审计）：
#   {
#     "products": [ ... ],
#     "source": {
#       "source_type": "internal-gateway",
#       "provider": "your-shop-bridge",
#       "auth_mode": "service_account",
#       "issuer": "tiktok"
#     }
#   }
#
# Skill 验真（TIKTOK_SHOP_SOURCE_ATTESTATION=internal-gateway）要求 source 字段匹配：
#   source_type=internal-gateway
#   provider=internal-gateway  OR  tiktok_shop_open_platform
#   auth_mode=service_account OR internal_token OR merchant_oauth OR partner_oauth
#
# =============================================================================
# 验收命令
# =============================================================================
#
# 终端 A：
#   python scripts/run_shop_gateway.py --port 8791
#
# 终端 B：
#   python scripts/run_scene06.py ^
#     --capture-root "D:\path\capture-pack" ^
#     --data-path official ^
#     --shop-http-url "http://127.0.0.1:8791" ^
#     --shop-source-attestation internal-gateway ^
#     --shop-require-verified-source ^
#     --shop-http-allowed-hosts "127.0.0.1"
#
# python scripts/validate_platform_integrations.py
